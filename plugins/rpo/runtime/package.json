{
  "name": "rpo-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for the Register právnických osôb, podnikateľov a orgánov verejnej moci (RPO)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:http": "tsx src/server-http.ts",
    "build": "tsc --project tsconfig.build.json",
    "start:prod": "node dist/server-http.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests --exclude='**/*.live.test.ts'"
  },
  "keywords": [
    "mcp",
    "rpo",
    "statistics.sk",
    "slovakia",
    "due-diligence"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Omni-Legal-Products/mcp-rpo.git"
  },
  "homepage": "https://github.com/Omni-Legal-Products/mcp-rpo#readme"
}
