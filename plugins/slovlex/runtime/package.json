{
  "name": "slov-lex_mcp",
  "version": "1.3.1",
  "description": "MCP server for Slov-Lex (Zbierka zákonov SR): load laws, versions and paragraphs.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http-server.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "tsx --test src/*.test.ts && npm run test:contracts",
    "test:contracts": "node --test tests/catalog-contract.test.mjs",
    "diagrams:export": "node scripts/export-diagrams.mjs",
    "diagrams:check": "node scripts/export-diagrams.mjs --check",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "smoke": "node dist/smoke.js"
  },
  "keywords": [
    "mcp",
    "slovakia",
    "legislation",
    "slov-lex"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/Omni-Legal-Products/mcp-slovlex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omni-Legal-Products/mcp-slovlex.git"
  },
  "bugs": {
    "url": "https://github.com/Omni-Legal-Products/mcp-slovlex/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.1.2",
    "lru-cache": "^11.2.4",
    "mammoth": "^1.11.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
