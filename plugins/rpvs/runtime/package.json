{
  "name": "rpvs-mcp",
  "version": "0.2.0",
  "description": "Read-only MCP server for the Slovak RPVS register (Register partnerov verejneho sektora)",
  "type": "module",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "start:http": "tsx src/server-http.ts",
    "build": "tsc --project tsconfig.build.json",
    "start:prod": "node dist/server-http.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests --exclude='**/*.live.test.ts'"
  },
  "keywords": [
    "mcp",
    "rpvs",
    "slovakia",
    "due-diligence",
    "ubo",
    "odata"
  ],
  "author": "originalmagneto",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Omni-Legal-Products/mcp-rpvs.git"
  },
  "homepage": "https://github.com/Omni-Legal-Products/mcp-rpvs#readme"
}
