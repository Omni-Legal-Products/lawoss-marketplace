{
  "name": "crz-mcp",
  "version": "1.3.1",
  "description": "MCP server for Centrálny register zmlúv (CRZ, Slovakia): search, fetch, convert PDFs/DOCX to Markdown, and extract legal clauses.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http-server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "smoke": "tsx src/smoke.ts",
    "bulk": "tsx src/crz/bulk.ts"
  },
  "keywords": [
    "mcp",
    "crz",
    "centralny-register-zmluv",
    "slovakia",
    "legal",
    "contracts"
  ],
  "author": {
    "name": "LAWOSS",
    "url": "https://github.com/Omni-Legal-Products"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "cheerio": "^1.1.2",
    "express": "^4.21.2",
    "lru-cache": "^11.2.4",
    "mammoth": "^1.11.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "jszip": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "@hono/node-server": "1.19.15",
    "express@^4.21.2": {
      "body-parser": "1.20.6"
    },
    "express@^5.2.1": {
      "body-parser": "2.3.0"
    },
    "fast-uri": "3.1.6",
    "hono": "4.13.2",
    "ip-address": "10.5.0",
    "qs": "6.16.0",
    "esbuild": "0.28.2",
    "undici": "7.29.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Omni-Legal-Products/mcp-crz.git"
  },
  "homepage": "https://github.com/Omni-Legal-Products/mcp-crz#readme"
}
